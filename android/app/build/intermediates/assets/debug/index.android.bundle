:'\u0926\u0941\u0915\u093e\u0928 \u0915\u093e \u092a\u0924\u093e',vl:'\u0917\u093e\u0902\u0935 / \u0936\u0939\u0930',ds:'\u091c\u093c\u093f\u0932\u093e',opt:'\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915',upc:'\u092b\u0930\u094d\u092e/\u0926\u0941\u0915\u093e\u0928 \u0915\u093e \u092a\u0948\u0928 \u0915\u093e\u0930\u094d\u0921 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902',usl:'\u092c\u0940\u091c \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902',upl:'\u0915\u0940\u091f\u0928\u093e\u0936\u0915 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902',ufl:'\u0909\u0930\u094d\u0935\u0930\u0915 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902',usp:'\u0926\u0941\u0915\u093e\u0928 \u0915\u093e \u092b\u094b\u091f\u094b \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902',eg2:'\u091c\u0940\u090f\u0938\u091f\u0940 \u0928\u0902\u092c\u0930 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902',rmp:'\u0915\u093e\u0930\u094d\u091f \u0938\u0947 \u0909\u0924\u094d\u092a\u093e\u0926 \u0939\u091f\u093e\u090f\u0901!',rmp2:'\u0915\u094d\u092f\u093e \u0906\u092a \u0907\u0938 \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u094b \u0915\u093e\u0930\u094d\u091f \u0938\u0947 \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?',yr:'\u0939\u093e\u0901, \u0939\u091f\u093e\u090f\u0901',bd:'\u092c\u093f\u0932 \u0935\u093f\u0935\u0930\u0923',sub:'\u0915\u0941\u0932 \u092f\u094b\u0917',tax:'\u0915\u0930',shp:'\u0936\u093f\u092a\u093f\u0902\u0917 \u0936\u0941\u0932\u094d\u0915',tp:'\u0915\u0941\u0932 \u092f\u094b\u0917',ptc:'\u091a\u0947\u0915\u0906\u0909\u091f \u0915\u0930\u0947\u0902',cd:'\u0915\u0942\u092a\u0928 \u091b\u0942\u091f',acc:'\u0915\u0942\u092a\u0928 \u0915\u094b\u0921 \u0932\u093e\u0917\u0942 \u0915\u0930\u0947\u0902',sc:'\u0915\u0942\u092a\u0928 \u091a\u0941\u0928\u0947\u0902',ca:'\u0915\u0942\u09